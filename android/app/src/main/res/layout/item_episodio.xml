<?xml version="1.0" encoding="utf-8"?>
<!-- Un episodio (o una versión de una película): fotograma, nombre, progreso, versiones y descarga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:nextFocusRight="@id/botonDescarga"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/miniatura"
        android:layout_width="128dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="@color/panel2"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:id="@+id/fondoMiniatura"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/numero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- La carátula del fotograma es vertical con la imagen en el centro: recortada a 16:9 queda el fotograma. -->
            <ImageView
                android:id="@+id/imagen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/vista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/fondo_chapa"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="✓"
                android:textColor="#06210F"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:max="1000"
                android:visibility="gone"
                app:trackColor="#40FFFFFF"
                app:trackCornerRadius="0dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tenue"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVersiones"
        style="@style/Widget.MiCine.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:nextFocusLeft="@id/fila"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/botonDescarga"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Descargar"
        android:focusable="true"
        android:nextFocusLeft="@id/fila">

        <ImageView
            android:id="@+id/iconoDescarga"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_descargar"
            app:tint="#FFFFFF" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoDescarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="#FFFFFF"
            app:indicatorSize="30dp"
            app:trackColor="#40FFFFFF"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
