<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- La misma app vale para el Fire TV y otras teles: se maneja con el mando, sin pantalla táctil. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- MiCine corre en el ordenador de casa sin HTTPS: hay que permitir HTTP. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="MiCine"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MiCine"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ficha de una serie (temporadas y episodios) o de una película (versiones). -->
        <activity
            android:name=".FichaActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- No se recrea al girar la pantalla: VLC sigue reproduciendo sin cortes. -->
        <activity
            android:name=".ReproductorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MiCine.Reproductor" />
    </application>
</manifest>
